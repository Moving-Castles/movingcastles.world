{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "paths": {
      // Sanity TypeGen output (generated in packages/cms via `pnpm typegen:sanity`).
      // Only ever imported as types, so a TypeScript path is all it needs.
      // (SvelteKit 3 deprecates its `alias` option for package.json subpath
      // imports, which cannot point outside the package.)
      "@sanity-types": ["../cms/sanity.types.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
